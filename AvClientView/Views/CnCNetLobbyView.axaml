<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvClientView.ViewModels"
             x:Class="AvClientView.Views.CnCNetLobbyView"
             x:DataType="vm:CnCNetLobbyViewModel">
  <Panel>
    <Grid ColumnDefinitions="400,*,200" RowDefinitions="Auto,*,Auto" Margin="12">

      <!-- Chat colour and channel -->
      <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,6">
        <TextBlock Text="YOUR COLOR:" VerticalAlignment="Center" FontWeight="Bold" />
        <ComboBox Width="150" ItemsSource="{Binding ChatColors}" SelectedIndex="{Binding SelectedChatColorIndex}" />
        <TextBlock Text="CURRENT CHANNEL:" VerticalAlignment="Center" FontWeight="Bold" Margin="24,0,0,0" />
        <ComboBox Width="220" ItemsSource="{Binding ChatChannels}" SelectedIndex="{Binding SelectedChannelIndex}"
                  IsEnabled="{Binding IsConnected}" />
      </StackPanel>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Opacity="0.8" />

      <!-- Games -->
      <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Games}" SelectedIndex="{Binding SelectedGameIndex}"
               DoubleTapped="Games_DoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CnCNetGameItemViewModel">
            <StackPanel ToolTip.Tip="{Binding Players}">
              <TextBlock Text="{Binding RoomName}" FontWeight="Bold" />
              <TextBlock Text="{Binding Details}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Chat -->
      <ListBox Grid.Row="1" Grid.Column="1" Margin="12,0" ItemsSource="{Binding Messages}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ChatLineViewModel">
            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Users -->
      <ListBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Users}" />

      <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Create Game" Command="{Binding OpenCreateGameCommand}" IsEnabled="{Binding IsConnected}" />
        <Button Content="Join Game" Command="{Binding JoinGameCommand}" IsEnabled="{Binding IsConnected}" />
      </StackPanel>
      <TextBox Grid.Row="2" Grid.Column="1" Margin="12,8,12,0" Text="{Binding ChatInput}" Watermark="Type here to chat..."
               IsEnabled="{Binding IsConnected}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendChatCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Row="2" Grid.Column="2" Content="{Binding LogOutText}" Command="{Binding BackCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />
    </Grid>

    <!-- Login -->
    <Border IsVisible="{Binding ShowLogin}" Background="#E0101010" BorderBrush="Gray" BorderThickness="1" Padding="16"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
      <StackPanel Spacing="8">
        <TextBlock Text="Connect to CnCNet" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="Player name:" />
        <TextBox Text="{Binding PlayerName}" />
        <CheckBox Content="Remember me" IsChecked="{Binding RememberMe}" />
        <CheckBox Content="Stay connected outside of the CnCNet lobby" IsChecked="{Binding PersistentMode}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Connect" Command="{Binding ConnectCommand}" IsDefault="True" />
          <Button Content="Cancel" Command="{Binding BackCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Create game -->
    <Border IsVisible="{Binding ShowCreateGame}" Background="#E0101010" BorderBrush="Gray" BorderThickness="1" Padding="16"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
      <StackPanel Spacing="8">
        <TextBlock Text="Create Game" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="Game room name:" />
        <TextBox Text="{Binding NewRoomName}" MaxLength="23" />
        <TextBlock Text="Password (leave blank for none):" />
        <TextBox Text="{Binding NewRoomPassword}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Maximum number of players:" VerticalAlignment="Center" Width="200" />
          <ComboBox Width="80" ItemsSource="{Binding MaxPlayerItems}" SelectedIndex="{Binding NewRoomMaxPlayersIndex}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Skill level:" VerticalAlignment="Center" Width="200" />
          <ComboBox Width="150" ItemsSource="{Binding SkillLevels}" SelectedIndex="{Binding NewRoomSkillLevel}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Create Game" Command="{Binding CreateGameCommand}" IsDefault="True" />
          <Button Content="Cancel" Command="{Binding CancelCreateGameCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Password -->
    <Border IsVisible="{Binding ShowPasswordPrompt}" Background="#E0101010" BorderBrush="Gray" BorderThickness="1" Padding="16"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
      <StackPanel Spacing="8">
        <TextBlock Text="Password required" FontSize="18" FontWeight="Bold" />
        <TextBox Text="{Binding JoinPassword}" PasswordChar="*" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Join" Command="{Binding SubmitPasswordCommand}" IsDefault="True" />
          <Button Content="Cancel" Command="{Binding CancelPasswordCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>

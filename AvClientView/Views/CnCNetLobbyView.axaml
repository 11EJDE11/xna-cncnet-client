<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvClientView.ViewModels"
             xmlns:views="using:AvClientView.Views"
             x:Class="AvClientView.Views.CnCNetLobbyView"
             x:DataType="vm:CnCNetLobbyViewModel"
             Background="Black">
  <Panel>
    <!-- The theme's CnCNetLobby layout, built in code-behind -->
    <ContentControl x:Name="LobbyHost" HorizontalAlignment="Center" VerticalAlignment="Center" />

    <!-- Login: the theme's CnCNetLoginWindow, built in code-behind -->
    <ContentControl x:Name="LoginHost" IsVisible="{Binding ShowLogin}" HorizontalAlignment="Center" VerticalAlignment="Center" />

    <!-- Create game: the theme's GameCreationWindow, built in code-behind -->
    <!-- The XNA DarkeningPanel behind the window: black at alpha 128 -->
    <Panel IsVisible="{Binding ShowCreateGame}" Background="#80000000">
      <ContentControl x:Name="CreateHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

    <!-- Password: the theme's PasswordRequestWindow, built in code-behind -->
    <ContentControl x:Name="PasswordHost" IsVisible="{Binding ShowPasswordPrompt}" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Panel>
</UserControl>

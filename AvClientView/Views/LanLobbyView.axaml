<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvClientView.ViewModels"
             x:Class="AvClientView.Views.LanLobbyView"
             x:DataType="vm:LanLobbyViewModel"
             Background="Black">
  <!-- The theme's LANLobby layout, built in code-behind -->
  <Panel>
    <ContentControl x:Name="LobbyHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <!-- LANGameCreationWindow over a darkening panel -->
    <Panel x:Name="CreationHost" Background="#80000000" IsVisible="{Binding ShowCreationWindow}" />
  </Panel>
</UserControl>

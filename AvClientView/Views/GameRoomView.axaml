<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvClientView.ViewModels"
             x:Class="AvClientView.Views.GameRoomView"
             x:DataType="vm:MultiplayerRoomViewModel"
             Background="Black">
  <!-- The theme's MultiplayerGameLobby layout (from LANGameLobby.ini or CnCNetGameLobby.ini), built in code-behind -->
  <ContentControl x:Name="LobbyHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
</UserControl>

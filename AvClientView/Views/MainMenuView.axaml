<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvClientView.ViewModels"
             x:Class="AvClientView.Views.MainMenuView"
             x:DataType="vm:MainMenuViewModel"
             Background="Black">
  <Panel>
    <!-- The theme's main menu (MainMenu.ini), centred as the XNA client centres it; built in code-behind -->
    <ContentControl x:Name="MenuHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TextBlock Text="{Binding Status}" Margin="12,6" Opacity="0.7" Foreground="Silver"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" />
  </Panel>
</UserControl>

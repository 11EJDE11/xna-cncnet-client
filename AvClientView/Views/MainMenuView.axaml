<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvClientView.ViewModels"
             x:Class="AvClientView.Views.MainMenuView"
             x:DataType="vm:MainMenuViewModel"
             Background="Black">
  <Grid RowDefinitions="*,Auto">
    <!-- The theme's main menu (MainMenu.ini), built in code-behind -->
    <ContentControl x:Name="MenuHost" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="12,6" Opacity="0.7" Foreground="Silver" />
  </Grid>
</UserControl>

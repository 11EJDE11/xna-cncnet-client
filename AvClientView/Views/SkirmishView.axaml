<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvClientView.ViewModels"
             xmlns:views="using:AvClientView.Views"
             x:Class="AvClientView.Views.SkirmishView"
             x:DataType="vm:SkirmishViewModel">
  <Grid RowDefinitions="*,Auto" Margin="12">
    <views:LobbyPanel Grid.Row="0" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Launch Game" Command="{Binding LaunchCommand}" />
      <Button Content="Main Menu" Command="{Binding BackCommand}" />
    </StackPanel>
  </Grid>
</UserControl>

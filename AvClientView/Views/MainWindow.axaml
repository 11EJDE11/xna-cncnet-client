<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvClientView.ViewModels"
        xmlns:views="using:AvClientView.Views"
        x:Class="AvClientView.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="768"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:LoadingScreenViewModel">
      <views:LoadingScreenView />
    </DataTemplate>
    <DataTemplate DataType="vm:MainMenuViewModel">
      <views:MainMenuView />
    </DataTemplate>
    <DataTemplate DataType="vm:SkirmishViewModel">
      <views:SkirmishView />
    </DataTemplate>
    <DataTemplate DataType="vm:LanLobbyViewModel">
      <views:LanLobbyView />
    </DataTemplate>
    <DataTemplate DataType="vm:CnCNetLobbyViewModel">
      <views:CnCNetLobbyView />
    </DataTemplate>
    <DataTemplate DataType="vm:GameLoadingRoomViewModel">
      <views:GameLoadingRoomView />
    </DataTemplate>
    <DataTemplate DataType="vm:MultiplayerRoomViewModel">
      <views:GameRoomView />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid x:Name="Root">
    <ContentControl Content="{Binding CurrentPage}" />
  </Grid>
</Window>
